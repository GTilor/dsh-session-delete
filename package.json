{
  "name": "dsh-session-delete-lite",
  "version": "1.0.2",
  "description": "极简 DeepSeek Harness 插件，只提供侧栏会话删除功能。 A minimal DeepSeek Harness plugin that only adds a Delete session action to the sidebar.",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "author": {
    "name": "lvguo"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTilor/dsh-session-delete.git"
  },
  "homepage": "https://github.com/GTilor/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/GTilor/dsh-session-delete/issues"
  },
  "exports": {
    ".": "./index.js",
    "./web-agents": "./web-agents.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "web-agents.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5 || ^0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
